# Database
DATABASE_URL=postgresql://user:password@postgres:5432/integrity

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-this-secret-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# App
APP_ENV=development
DEBUG=true

# Email (choose one)
# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# OR SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@instantintegrity.com
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Phase 2: ML Configuration
MODEL_PATH=models
CONFIG_PATH=config/preprocessing.yaml
